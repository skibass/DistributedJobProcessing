{
  "openapi": "3.0.1",
  "info": {
    "title": "DistributedJobProcessing",
    "version": "1.0"
  },
  "paths": {
    "/add": {
      "post": {
        "tags": [
          "Worker"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Worker"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Worker"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Worker"
                }
              }
            }
          }
        }
      }
    },
    "/get/{id}": {
      "get": {
